# RideShare Backend — environment template
# Copy to .env.dev / .env.staging / .env.prod and fill in per environment.
# NEVER commit the filled-in files. Values below are placeholders only.

# --- Database (same Atlas cluster, different DB per env: rideshare-dev|staging|prod) ---
MONGO_URI=

# --- Auth ---
# Signs every access token. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Non-prod OTP bypass: any seeded user logs in with this code (no SMS). Leave blank in prod.
TEST_OTP=

# --- Redis (usually provided inline by docker-compose; override here if needed) ---
REDIS_HOST=
REDIS_PORT=
REDIS_IS_ENABLED=
REDIS_DB=
BULLMQ_ENABLED=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_KEY=
STRIPE_CONNECTED_WEBHOOK_KEY=

# --- App ---
FRONTEND_URL=

# --- CDN / S3 ---
CDN_TYPE=
CDN_REGION=
CDN_BUCKET_NAME=
CDN_ENDPOINT=
CDN_KEY=
CDN_SECRET=

# --- Veriff (identity verification) ---
VERIFF_API_KEY=
VERIFF_BASE_URL=
VERIFF_API_SECRET=

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SID=
TWILIO_ENABLED=

# --- SendGrid (email) ---
SENDGRID_ENABLED=
SENDGRID_API_KEY=
SENDGRID_SENDER=

# --- Firebase Admin ---
# The app reads firebase-adminsdk.json (gitignored). Place the real file on the host,
# or switch to FIREBASE_* env vars if you refactor away from the JSON file.
