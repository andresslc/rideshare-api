# ----------------------
# App Config
# ----------------------
APP_NAME=MyApp
NODE_ENV=development
PORT=3050
SERVICE_URL=http://localhost:3050

# ----------------------
# JWT Config
# ----------------------
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=7d

# ----------------------
# MongoDB
# ----------------------
MONGO_URI=mongodb://localhost:27017/app

# ----------------------
# Stripe
# ----------------------
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_KEY=your_stripe_webhook_key
STRIPE_WEBHOOK_KEY_MAIN=your_stripe_webhook_key_main
STRIPE_APPLICATION_FEE=0
STRIPE_REQUEST_TIMEOUT_MS=10000
STRIPE_MAX_NETWORK_RETRIES=1

# ----------------------
# SendGrid
# ----------------------
SENDGRID_ENABLED=true
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_SENDER=your_sendgrid_email@example.com

# ----------------------
# NodeMailer
# ----------------------
NODEMAILER_ENABLED=true
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# ----------------------
# Twilio
# ----------------------
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SID=your_twilio_messaging_sid
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# ----------------------
# CDN (AWS S3 or other)
# ----------------------
CDN_TYPE=aws
CDN_REGION=your_cdn_region
CDN_BUCKET_NAME=your_bucket_name
CDN_ENDPOINT=your_cdn_endpoint
CDN_KEY=your_cdn_access_key
CDN_SECRET=your_cdn_secret_key

# ----------------------
# Redis
# ----------------------
REDIS_IS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_PASSWORD=
REDIS_DB=0

# ----------------------
# BullMQ
# ----------------------
BULLMQ_ENABLED=true

# Journey audit trail (server-side only). Live locations are still broadcast
# normally; MongoDB stores at most one breadcrumb per active journey interval.
JOURNEY_LOCATION_SAMPLE_INTERVAL_SECONDS=180
