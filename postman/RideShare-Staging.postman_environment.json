{
  "id": "rideshare-env-staging",
  "name": "RideShare — Staging",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://api.staging.example.com/api",
      "enabled": true,
      "type": "default",
      "description": "API root for RideShare — Staging. Shared Atlas database, pre-release. Treat data as if it were real."
    },
    {
      "key": "socketUrl",
      "value": "wss://api.staging.example.com",
      "enabled": true,
      "type": "default",
      "description": "Socket.IO endpoint. Not under /api — it attaches to the server root."
    },
    {
      "key": "baseUrlDocker",
      "value": "http://localhost:3002/api",
      "enabled": false,
      "type": "default",
      "description": "Same environment run locally with docker-compose.staging.yml. Copy this into baseUrl to point at your own machine instead of the deployed host."
    },
    {
      "key": "token",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "driverToken",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "adminToken",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "testOtp",
      "value": "",
      "enabled": true,
      "type": "default",
      "description": "TEST_OTP is not set here — the OTP arrives by real SMS."
    }
  ],
  "_postman_variable_scope": "environment"
}
