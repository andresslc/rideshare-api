{
  "id": "rideshare-env-dev",
  "name": "RideShare — Dev",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://api.dev.example.com/api",
      "enabled": true,
      "type": "default",
      "description": "API root for RideShare — Dev. Shared Atlas database. Twilio and SendGrid are live: OTPs arrive by real SMS and TEST_OTP is unset."
    },
    {
      "key": "socketUrl",
      "value": "wss://api.dev.example.com",
      "enabled": true,
      "type": "default",
      "description": "Socket.IO endpoint. Not under /api — it attaches to the server root."
    },
    {
      "key": "baseUrlDocker",
      "value": "http://localhost:3001/api",
      "enabled": false,
      "type": "default",
      "description": "Same environment run locally with docker-compose.dev.yml. Copy this into baseUrl to point at your own machine instead of the deployed host."
    },
    {
      "key": "token",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "driverToken",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "adminToken",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "testOtp",
      "value": "",
      "enabled": true,
      "type": "default",
      "description": "TEST_OTP is not set here — the OTP arrives by real SMS."
    }
  ],
  "_postman_variable_scope": "environment"
}
