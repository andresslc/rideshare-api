{
  "id": "rideshare-env-local",
  "name": "RideShare — Local",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "enabled": true,
      "type": "default",
      "description": "API root for RideShare — Local. Self-contained stack: Mongo and Redis in containers, toy data, no real SMS or email."
    },
    {
      "key": "socketUrl",
      "value": "ws://localhost:3000",
      "enabled": true,
      "type": "default",
      "description": "Socket.IO endpoint. Not under /api — it attaches to the server root."
    },
    {
      "key": "baseUrlDocker",
      "value": "http://localhost:3000/api",
      "enabled": false,
      "type": "default",
      "description": "Same environment run locally with docker-compose.local.yml. Copy this into baseUrl to point at your own machine instead of the deployed host."
    },
    {
      "key": "token",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "driverToken",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "adminToken",
      "value": "",
      "enabled": true,
      "type": "secret"
    },
    {
      "key": "testOtp",
      "value": "123456",
      "enabled": true,
      "type": "default",
      "description": "TEST_OTP for this environment: the OTP bypass, so no SMS is sent."
    }
  ],
  "_postman_variable_scope": "environment"
}
